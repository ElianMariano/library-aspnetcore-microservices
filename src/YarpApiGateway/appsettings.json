{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "book-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/book/{**catch-all}"
        }
      },
      "books-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/books/{**catch-all}"
        }
      },
      "author-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/author/{**catch-all}"
        }
      },
      "authors-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/authors/{**catch-all}"
        }
      },
      "category-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/category/{**catch-all}"
        }
      },
      "categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/categories/{**catch-all}"
        }
      },

      "bookinventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/bookinventory/{**catch-all}"
        }
      },
      "bookinventories-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/bookinventories/{**catch-all}"
        }
      },
      "reservation-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/reservation/{**catch-all}"
        }
      },
      "reservations-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/reservations/{**catch-all}"
        }
      },

      "loanregistry-route": {
        "ClusterId": "loan-cluster",
        "Match": {
          "Path": "/loanregistry/{**catch-all}"
        }
      },
      "returnloanregistry-route": {
        "ClusterId": "loan-cluster",
        "Match": {
          "Path": "/returnloanregistry/{**catch-all}"
        }
      },
      "loanregistries-route": {
        "ClusterId": "loan-cluster",
        "Match": {
          "Path": "/loanregistries/{**catch-all}"
        }
      },

      "member-route": {
        "ClusterId": "membership-cluster",
        "Match": {
          "Path": "/member/{**catch-all}"
        }
      },
      "members-route": {
        "ClusterId": "membership-cluster",
        "Match": {
          "Path": "/members/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://catalog.api:8080"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://inventory.api:8080"
          }
        }
      },
      "loan-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://loan.api:8080"
          }
        }
      },
      "membership-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://membership.api:8080"
          }
        }
      }
    }
  }
}
